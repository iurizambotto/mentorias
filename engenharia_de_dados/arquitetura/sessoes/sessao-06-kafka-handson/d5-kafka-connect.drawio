<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Kafka Connect Pipeline">
    <mxGraphModel dx="800" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="480" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Source DB -->
        <mxCell id="2" value="PostgreSQL / MySQL / MongoDB" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- Debezium Source Connector -->
        <mxCell id="3" value="Debezium Source Connector&#xa;(lê WAL / binlog do banco)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="155" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- Kafka Topic -->
        <mxCell id="4" value="Kafka Topic&#xa;(cleanup: compact | key: entidade_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="115" y="285" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- Sink Connector -->
        <mxCell id="5" value="S3 / MinIO Sink Connector&#xa;(Kafka Connect Framework)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="415" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- Destination -->
        <mxCell id="6" value="MinIO / S3 / Snowflake / BigQuery" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="110" y="540" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- Arrow: DB → Debezium -->
        <mxCell id="7" value="WAL / binlog / changelog" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#666666;fontColor=#555555;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Debezium → Topic -->
        <mxCell id="8" value="eventos CDC&#xa;{op: c/u/d, before, after}" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#d79b00;fontColor=#8a6000;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Topic → Sink -->
        <mxCell id="9" value="consume (grupo dedicado)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#d6b656;fontColor=#8a7200;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Sink → Destination -->
        <mxCell id="10" value="Parquet / Avro / JSON" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;strokeColor=#82b366;fontColor=#3a7030;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
