    {
      "id": "Lab 2",
      "titulo": "Criar o topico com 3 particoes",
      "nivel": 3,
      "comandos": [
        "docker exec mentoria-s11-kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --create --topic eventos-mkt --partitions 3 --replication-factor 1"
      ],
      "saida_esperada": "Created topic eventos-mkt."
    },
    {
      "id": "Lab 3",
      "titulo": "Inspecionar particoes e lider",
      "nivel": 3,
      "comandos": [
        "docker exec mentoria-s11-kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --describe --topic eventos-mkt"
      ],
      "saida_esperada": "PartitionCount: 3, ReplicationFactor: 1, com Leader: 1 em cada particao"
    },
    {
      "id": "Lab 4",
      "titulo": "Produzir eventos com chave",
      "nivel": 3,
      "comandos": [
        "docker exec mentoria-s11-kafka /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server localhost:9092 --topic eventos-mkt --property parse.key=true --property key.separator=:"
      ],
      "saida_esperada": "sem erro, o produtor encerra ao fechar a entrada"
    },
    {
      "id": "Lab 5",
      "titulo": "Consumir e observar a particao de cada chave",
      "nivel": 3,
      "comandos": [
        "docker exec mentoria-s11-kafka /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server localhost:9092 --topic eventos-mkt --from-beginning --property print.key=true --property print.partition=true --timeout-ms 12000"
      ],
      "saida_esperada": "Partition:0 u2, depois Partition:1 u1 duas vezes. A mesma chave cai sempre na mesma particao"
    },
    {
      "id": "Lab 6",
      "titulo": "Inspecionar offset do grupo de consumo",
      "nivel": 3,
      "comandos": [
        "docker exec mentoria-s11-kafka /opt/kafka/bin/kafka-consumer-groups.sh --bootstrap-server localhost:9092 --describe --group time-analytics"
      ],
      "saida_esperada": "particao 0 com CURRENT-OFFSET 1 e particao 1 com 2, LAG 0 nas duas"
