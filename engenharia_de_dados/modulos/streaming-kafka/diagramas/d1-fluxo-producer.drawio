<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Fluxo do Producer">
    <mxGraphModel dx="1000" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="730" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Producer swimlane -->
        <mxCell id="2" value="Producer" style="swimlane;startSize=35;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="225" height="360" as="geometry" />
        </mxCell>
        <mxCell id="9" value="produce() é assíncrona:&#xa;retorna imediatamente,&#xa;sem aguardar o broker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="2">
          <mxGeometry x="15" y="55" width="195" height="75" as="geometry" />
        </mxCell>
        <mxCell id="10" value="flush()&#xa;bloqueia até todas as&#xa;confirmações chegarem." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="2">
          <mxGeometry x="15" y="258" width="195" height="70" as="geometry" />
        </mxCell>

        <!-- Broker swimlane -->
        <mxCell id="3" value="Broker (Kafka)" style="swimlane;startSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="315" y="20" width="390" height="360" as="geometry" />
        </mxCell>
        <mxCell id="4" value="① hash(key) % N_partições&#xa;→ determina a partição destino" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="20" y="60" width="350" height="65" as="geometry" />
        </mxCell>
        <mxCell id="5" value="② grava no log da partição&#xa;(acréscimo sequencial e imutável)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="20" y="150" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="③ retorna: partição + offset&#xa;atribuídos à mensagem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="20" y="240" width="350" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow: produce() -->
        <mxCell id="7" value="produce(topic, key, value)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;strokeColor=#6c8ebf;fontColor=#1a3c6e;fontStyle=1;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.22;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: callback -->
        <mxCell id="8" value="delivery_callback(err, msg)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;strokeColor=#82b366;fontColor=#1a5c1a;fontStyle=1;exitX=0;exitY=0.83;exitDx=0;exitDy=0;entryX=1;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
